{
    "manifest_version": 3,
    "name": "Article Summarizer",
    "version": "1.0",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": ["activeTab", "tabs", "storage"],
    "host_permissions": [
        "<all_urls>",
        "https://ai-extension-summarizer-monorepo.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}

